        "jobs": 1
      },
      "environment": {
        "STM32_GDBTEST_IDENTITY_POLICY": "strict",
        "STM32_GDBTEST_STAND": "${sourceDir}/hil/F103CB/stands/local.toml"
      }
    },
    {
