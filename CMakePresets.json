      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "environment": {
        "STM32_GDBTEST_IDENTITY_POLICY": "strict"
      }
    },
    {
      "name": "f103c8-hil-hw",
      "configurePreset": "f103c8-hil",
      "displayName": "F103C8_PC13: локальная плата",
      "filter": {
        "include": {
          "label": "^hw$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "environment": {
        "STM32_GDBTEST_IDENTITY_POLICY": "strict",
        "STM32_GDBTEST_STAND": "${sourceDir}/hil/F103C8/stands/local.toml"
      }
    },
    {
      "name": "f103c8-hil-hw-remote",
