{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BLUEPILL_HIL": "OFF",
        "BLUEPILL_RENODE_TEST": "OFF"
      },
      "description": "Собственный CMake/CMSIS. ARM_TOOLCHAIN_ROOT или PATH; без MSVC и stm32-cmake-yml."
    },
    {
      "name": "f103c8-debug",
      "displayName": "DEBUG (F103C8_PC13)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103C8_PC13",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLUEPILL_RENODE_TEST": "ON"
      }
    },
    {
      "name": "f103c8-release",
      "displayName": "RELEASE (F103C8_PC13)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103C8_PC13",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "f103c8-hil",
      "displayName": "HIL (F103C8_PC13)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103C8_PC13",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLUEPILL_HIL": "ON"
      }
    },
    {
      "name": "f103cb-debug",
      "displayName": "DEBUG (F103CB_PB2)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103CB_PB2",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLUEPILL_RENODE_TEST": "ON"
      }
    },
    {
      "name": "f103cb-release",
      "displayName": "RELEASE (F103CB_PB2)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103CB_PB2",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "f103cb-hil",
      "displayName": "HIL (F103CB_PB2)",
      "inherits": "base",
      "cacheVariables": {
        "BOARD": "F103CB_PB2",
        "CMAKE_BUILD_TYPE": "Debug",
        "BLUEPILL_HIL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "f103c8-debug",
      "configurePreset": "f103c8-debug",
      "displayName": "DEBUG (F103C8_PC13)"
    },
    {
      "name": "f103c8-release",
      "configurePreset": "f103c8-release",
      "displayName": "RELEASE (F103C8_PC13)"
    },
    {
      "name": "f103c8-hil",
      "configurePreset": "f103c8-hil",
      "displayName": "HIL (F103C8_PC13)"
    },
    {
      "name": "f103cb-debug",
      "configurePreset": "f103cb-debug",
      "displayName": "DEBUG (F103CB_PB2)"
    },
    {
      "name": "f103cb-release",
      "configurePreset": "f103cb-release",
      "displayName": "RELEASE (F103CB_PB2)"
    },
    {
      "name": "f103cb-hil",
      "configurePreset": "f103cb-hil",
      "displayName": "HIL (F103CB_PB2)"
    }
  ],
  "testPresets": [
    {
      "name": "f103c8-debug-emulator",
      "configurePreset": "f103c8-debug",
      "displayName": "F103C8_PC13: Renode, без платы",
      "filter": {
        "include": {
          "label": "^emu$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      }
    },
    {
      "name": "f103c8-hil",
      "configurePreset": "f103c8-hil",
      "displayName": "F103C8_PC13: host/prepare, без платы",
      "filter": {
        "include": {
          "label": "^host$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "environment": {
        "STM32_GDBTEST_IDENTITY_POLICY": "strict"
      }
    },
    {
      "name": "f103c8-hil-host",
      "configurePreset": "f103c8-hil",
      "displayName": "F103C8_PC13: host/prepare, без платы",
      "filter": {
        "include": {
