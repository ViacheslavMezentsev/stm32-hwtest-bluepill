        "noTestsAction": "error",
        "jobs": 1
      },
      "environment": {
        "STM32_GDBTEST_IDENTITY_POLICY": "strict",
        "STM32_GDBTEST_STAND": "${sourceDir}/hil/F103C8/stands/remote.toml"
      }
    },
    {
      "name": "f103cb-debug-emulator",
      "configurePreset": "f103cb-debug",
      "displayName": "F103CB_PB2: Renode, без платы",
      "filter": {
