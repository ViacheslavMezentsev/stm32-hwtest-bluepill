{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "Сборка: собрать (активный пресет)",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Сборка: конфигурировать debug…",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "${input:board}-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Сборка: конфигурировать release…",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "${input:board}-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Сборка: конфигурировать hil…",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "${input:board}-hil"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Проверка: CTest (активная сборка, без платы)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${command:cmake.buildDirectory}",
        "-L",
        "^(host|emu)$",
        "--no-tests=error",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Сборка: собрать (активный пресет)"
    },
    {
      "label": "Эмуляция: стартовый лог (Renode)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--target",
        "emulate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Эмуляция: Renode с GDB (порт 3334)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--target",
        "emulate-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "GDB server with all CPUs started on port"
        }
      },
      "isBackground": true
    },
    {
      "label": "Прошивка: OpenOCD / ST-Link",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32f1x.cfg",
        "-c",
        "program {${command:cmake.buildDirectory}/stm32_hwtest_bluepill.elf} verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Сборка: собрать (активный пресет)"
    },
    {
      "label": "Прошивка: STM32CubeProgrammer / ST-Link",
      "type": "process",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c",
        "port=SWD",
        "-w",
        "${command:cmake.buildDirectory}/stm32_hwtest_bluepill.hex",
        "-v",
        "-rst"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Сборка: собрать (активный пресет)"
    },
    {
      "label": "HIL: F103C8 — конфигурировать",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "f103c8-hil"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HIL: F103C8 — собрать",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "f103c8-hil"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103C8 — конфигурировать"
    },
    {
      "label": "HIL: F103C8 — doctor (локальный стенд)",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
        "doctor",
        "--gdb",
        "${config:toolchain}/bin/arm-none-eabi-gdb-py3",
        "--stand",
        "hil/F103C8/stands/local.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "args": [
          "-B",
          "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
          "doctor",
          "--gdb",
          "${config:toolchain}/bin/arm-none-eabi-gdb-py3.exe",
          "--stand",
          "hil/F103C8/stands/local.toml"
        ]
      }
    },
    {
      "label": "HIL: F103C8 — подготовка без платы",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103c8-hil-host"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103C8 — собрать"
    },
    {
      "label": "HIL: F103C8 — все тесты (локальная плата)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103c8-hil-hw"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103C8 — собрать"
    },
    {
      "label": "HIL: F103C8 — все тесты (удалённая плата)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103c8-hil-hw-remote"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103C8 — собрать"
    },
    {
      "label": "HIL: F103C8 — один тест (локальная плата)…",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
        "run",
        "--session",
        "build/f103c8-hil/hwtest/session.json",
        "--identity-policy",
        "strict",
        "--test",
        "${input:test}",
        "--stand",
        "hil/F103C8/stands/local.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103C8 — собрать"
    },
    {
      "label": "HIL: F103C8 — результаты",
      "type": "process",
      "command": "python",
      "args": [
        "hil/tools/results.py",
        "--runs",
        "build/f103c8-hil/hwtest/runs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HIL: F103CB — конфигурировать",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "f103cb-hil"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HIL: F103CB — собрать",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "f103cb-hil"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103CB — конфигурировать"
    },
    {
      "label": "HIL: F103CB — doctor (локальный стенд)",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
        "doctor",
        "--gdb",
        "${config:toolchain}/bin/arm-none-eabi-gdb-py3",
        "--stand",
        "hil/F103CB/stands/local.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "args": [
          "-B",
          "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
          "doctor",
          "--gdb",
          "${config:toolchain}/bin/arm-none-eabi-gdb-py3.exe",
          "--stand",
          "hil/F103CB/stands/local.toml"
        ]
      }
    },
    {
      "label": "HIL: F103CB — подготовка без платы",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103cb-hil-host"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103CB — собрать"
    },
    {
      "label": "HIL: F103CB — все тесты (локальная плата)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103cb-hil-hw"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103CB — собрать"
    },
    {
      "label": "HIL: F103CB — все тесты (удалённая плата)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "f103cb-hil-hw-remote"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103CB — собрать"
    },
    {
      "label": "HIL: F103CB — один тест (локальная плата)…",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${config:hil.gdbtest}/stm32_gdbtest/cli.py",
        "run",
        "--session",
        "build/f103cb-hil/hwtest/session.json",
        "--identity-policy",
        "strict",
        "--test",
        "${input:test}",
        "--stand",
        "hil/F103CB/stands/local.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "HIL: F103CB — собрать"
    },
    {
      "label": "HIL: F103CB — результаты",
      "type": "process",
      "command": "python",
      "args": [
        "hil/tools/results.py",
        "--runs",
        "build/f103cb-hil/hwtest/runs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Прошивка: J-Link",
      "type": "process",
      "command": "cmake",
      "args": [
        "-DELF=${command:cmake.buildDirectory}/stm32_hwtest_bluepill.elf",
        "-DDEVICE=${config:device}",
        "-P",
        "${workspaceFolder}/cmake/flash-jlink.cmake"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "Сборка: собрать (активный пресет)"
    }
  ],
  "inputs": [
    {
      "id": "board",
      "type": "pickString",
      "description": "Профиль сборки",
      "options": [
        "f103c8",
        "f103cb"
      ],
      "default": "f103cb"
    },
    {
      "id": "test",
      "type": "pickString",
      "description": "Сценарий",
      "options": [
        "HW_BLINK",
        "HW_BOARD_PROFILE",
        "HW_BOOT",
        "HW_BOOT_CMSIS",
        "HW_GPIO_CONFIG",
        "HW_LED_FORCED_STATE",
        "HW_POST",
        "HW_POST_ADC_CLEANUP",
        "HW_POST_VDDA_LOW",
        "HW_SETUP_DONE",
        "HW_TOGGLE_WRITERS",
        "HW_UART_CONFIG",
        "HW_STARTUP_ORDER",
        "HW_SYSTICK_PROGRESS",
        "HW_ADC_INITIALIZATION"
      ],
      "default": "HW_BOOT"
    }
  ]
}
