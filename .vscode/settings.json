{
    // CMake Tools: presets, Ninja/ARM GCC; do not activate MSVC.
    "cmake.useCMakePresets": "always",
    "cmake.useVsDeveloperEnvironment": "never",
    "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "cSpell.ignoreRegExpList": ["\\b[0-9A-Z_]+\\b"],
    // Manual debugger settings are independent of the configure preset.
    // On Linux change toolchain to ${env:HOME}/xpack-arm-none-eabi-gcc-14.2.1-1.1.
    "toolchain": "${env:USERPROFILE}/xpack-arm-none-eabi-gcc-14.2.1-1.1",
    "executable": "${command:cmake.buildDirectory}/stm32_hwtest_bluepill.elf",
    "device": "STM32F103CB",
    "targetFamily": "stm32f1x",
    "svdFile": "",
    "cortex-debug.gdbPath.windows": "${config:toolchain}/bin/arm-none-eabi-gdb.exe",
    "cortex-debug.gdbPath.linux": "${config:toolchain}/bin/arm-none-eabi-gdb",
    "cortex-debug.openocdPath.windows": "openocd.exe",
    "cortex-debug.openocdPath.linux": "openocd",
    "cortex-debug.JLinkGDBServerPath.windows": "JLinkGDBServerCL.exe",
    "cortex-debug.JLinkGDBServerPath.linux": "JLinkGDBServerCLExe",
    "cortex-debug.stlinkPath.windows": "ST-LINK_gdbserver.exe",
    "cortex-debug.variableUseNaturalFormat": true,
    // Только текущая выбранная кампания DDTT; старые логи не смешиваются.
    "coverage-gutters.coverageBaseDir": "build/ddtt-view",
    "coverage-gutters.coverageFileNames": ["lcov.info"],
    "coverage-gutters.manualCoverageFilePaths": [],
    "coverage-gutters.showLineCoverage": true,
    "coverage-gutters.coverageReportFileName": "build/ddtt-view/index.html",
    "hil.gdbtest": "modules/stm32-gdbtest"
}
